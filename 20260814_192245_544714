encoding=\\\"utf-8\\\"), ensure_ascii=False, indent=2)\\n106|\\n107|\\n108|def reply_chain(recs):\\n109|    \\\"\\\"\\\"Devolve dict id->texto curto para mostrar 'respondeu a X'.\\\"\\\"\\\"\\n110|    return {r[\\\"id\\\"]: r for r in recs}\\n111|\\n112|\\n113|def _fmt(recs, since=None, limit=50):\\n114|    chain = reply_chain(recs)\\n115|    out = []\\n116|    shown = [r for r in recs if since is None or r[\\\"id\\\"] > since][-limit:]\\n117|    for r in shown:\\n118|        ts = time.strftime(\\\"%H:%M\\\", time.localtime(r[\\\"ts\\\"]))\\n119|        icon = {\\\"msg\\\": \\\"💬\\\", \\\"q\\\": \\\"❓\\\", \\\"state\\\": \\\"📌\\\"}.get(r[\\\"type\\\"], \\\"•\\\")\\n120|        line = f\\\"{icon} [{ts}] **{r['bot'].upper()}**: {r['text']}\\\"\\n121|        if r.get(\\\"reply_to\\\") and r[\\\"reply_to\\\"] in chain:\\n122|            orig = chain[r[\\\"reply_to\\\"]]\\n123|            line += f\\\"\\\\n     ↳ responde a {orig['bot'].upper()}: {orig['text'][:60]}\\\"\\n124|        if r.get(\\\"state\\\"):\\n125|            line += f\\\"\\\\n     📌 estado: {r['state']}\\\"\\n126|        out.append(line)\\n127|    return \\\"\\\\n\\\".join(out)\\n128|\\n129|\\n130|def show(limit=50, since=None):\\n131|    return _fmt(_read_chat(), since=since, limit=limit)\\n132|\\n133|\\n134|def watch():\\n135|    last = None\\n136|    recs = _read_chat()\\n137|    if recs:\\n138|        last = recs[-1][\\\"id\\\"]\\n139|    print(f\\\"grupo {GROUP_NAME} ao vivo (Ctrl-C p/ sair)\\\")\\n140|    try:\\n141|        while True:\\n142|            cur = _read_chat()\\n143|            new = [r for r in cur if last is None or r[\\\"id\\\"] > last]\\n144|            if new:\\n145|                print(_fmt(new))\\n146|                last = new[-1][\\\"id\\\"]\\n147|            time.sleep(2)\\n148|    except KeyboardInterrupt:\\n149|        pass\\n150|\\n151|\\n152|def main():\\n153|    p = argparse.ArgumentParser(description=\\\"Grupo de chat dos bots biblia-estudo\\\")\\n154|    sub = p.add_s