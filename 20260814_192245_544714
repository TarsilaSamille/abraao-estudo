s\\n31|import time\\n32|\\n33|# Resolve repo root a partir deste arquivo (bots/bus.py -> repo root)\\n34|HERE = os.path.dirname(os.path.abspath(__file__))\\n35|REPO = os.path.dirname(HERE)\\n36|BUS = os.path.join(REPO, \\\"bots\\\", \\\"state\\\", \\\"bus.jsonl\\\")\\n37|\\n38|# Registry dos bots (spec espelhado em bots/state/team.json)\\n39|BOTS = [\\\"audit\\\", \\\"implement\\\", \\\"check\\\", \\\"refactor\\\"]\\n40|\\n41|\\n42|def _now():\\n43|    return time.time()\\n44|\\n45|\\n46|def _ensure():\\n47|    os.makedirs(os.path.dirname(BUS), exist_ok=True)\\n48|    if not os.path.exists(BUS):\\n49|        open(BUS, \\\"a\\\").close()\\n50|\\n51|\\n52|def _read_all():\\n53|    _ensure()\\n54|    out = []\\n55|    with open(BUS, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n56|        for line in f:\\n57|            line = line.strip()\\n58|            if not line:\\n59|                continue\\n60|            try:\\n61|                out.append(json.loads(line))\\n62|            except json.JSONDecodeError:\\n63|                continue\\n64|    return out\\n65|\\n66|\\n67|def _append(rec):\\n68|    _ensure()\\n69|    with open(BUS, \\\"a\\\", encoding=\\\"utf-8\\\") as f:\\n70|        f.write(json.dumps(rec, ensure_ascii=False) + \\\"\\\\n\\\")\\n71|\\n72|\\n73|def send(to, body, frm=None, typ=\\\"msg\\\"):\\n74|    \\\"\\\"\\\"Envia mensagem. to='all' ou nome de bot. Retorna o id.\\\"\\\"\\\"\\n75|    if to != \\\"all\\\" and to not in BOTS:\\n76|        raise ValueError(f\\\"destinatário inválido: {to!r} (use all|{BOTS})\\\")\\n77|    rec = {\\n78|        \\\"id\\\": f\\\"{int(_now()*1000):015d}\\\",\\n79|        \\\"ts\\\": _now(),\\n80|        \\\"frm\\\": frm or \\\"unknown\\\",\\n81|        \\\"to\\\": to,\\n82|        \\\"type\\\": typ,\\n83|        \\\"body\\\": body,\\n84|        \\\"ack\\\": False,\\n85|    }\\n86|    _append(rec)\\n87|    return rec[\\\"id\\\"]\\n88|\\n89|\\n90|def inbox(bot, since_id=None, unread_only=True):\\n91|    \\\"\\\"\\\"Retorn