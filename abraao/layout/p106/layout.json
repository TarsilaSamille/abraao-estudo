   "x": 83.5,
   "y": 167.2,
   "w": 115.0,
   "size": 13.6,
   "flags": 0,
   "text": "and be blameless;"
  },
  {
   "x": 83.5,
   "y": 185.5,
   "w": 387.3,
   "size": 11.6,
   "flags": 0,
   "text": "2 then I will give a covenant between me and between you,"
  },
  {
   "x": 83.5,
   "y": 209.9,
   "w": 263.9,
   "size": 13.6,
   "flags": 0,
   "text": "and I will multiply you very, very much .”"
  },
  {
   "x": 60.2,
   "y": 228.2,
   "w": 235.2,
   "size": 11.6,
   "flags": 0,
   "text": "3 And Avram fell down upon his face."
