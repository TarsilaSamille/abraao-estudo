  "components": [
    {
      "name": "Language Toggle (PT/EN)",
      "kind": "button",
      "refersTo": "nav-lang",
      "description": "Pill split-toggle that switches the whole page between Portuguese and English via localStorage + html[lang].",
      "html": "<div class=\"ds-lang\"><button id=\"lang-pt\" class=\"ds-lang-btn ds-on\">PT</button><button id=\"lang-en\" class=\"ds-lang-btn\">EN</button></div>",
      "css": ".ds-lang{display:inline-flex;overflow:hidden;border-radius:999px;border:1px solid #cbd5e1;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.05)}.ds-lang-btn{padding:.375rem .875rem;font-size:.875rem;font-weight:600;color:#475569;background:#fff;border:0;cursor:pointer;transition:background .2s,color .2s}.ds-lang-btn:hover{background:#f1f5f9}.ds-lang-btn.ds-on{background:#0284c7;color:#fff}.ds-lang-btn:focus-visible{outline:2px solid #2563eb;outline-offset:2px}"
    },
    {
      "name": "Portal Course Card",
      "kind": "card",
      "refersTo": "course-card",
      "description": "Rounded course tile in the portal grid: cover image + title/reference/description, hover lifts and turns the border sky.",
      "html": "<a class=\"ds-card\" href=\"#\"><img class=\"ds-card-img\" src=\"#\" alt=\"\"><div class=\"ds-card-body\"><h3 class=\"ds-card-title\">Abraão</h3><p class=\"ds-card-ref\">Gênesis 11-25 • 30 Sessões</p><p class=\"ds-card-desc\">...</p></div></a>",
      "css": ".ds-card{display:flex;flex-direction:column;overflow:hidden;border-radius:16px;border:2px solid #e2e8f0;background:#fff;text-decoration:none;transition:transform .2s,box-shadow .2s,border-color .2s}.ds-card:hover{transform:translateY(-4px);border-color:#0ea5e9;box-shadow:0 20px 25px -5px rgba(0,0,0,.1)}.ds-card-img{height:11rem;width:100%;object-fit:cover}.ds-card-body{flex:1;padding:1.5rem;text-align:left}.ds-card-title{font-size:1.5rem;font-weight:800;color:#0f172a;margin-bottom:.5rem}.ds-card-title:hover{color:#0284c7}.ds-card-ref{font-size:.875rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#64748b;margin-bottom:.75rem}.ds-card-desc{font-size:.875rem;color:#475569;line-height:1.6}"
    },
    {
      "name": "Scripture Block",
      "kind": "card",
      "refersTo": "scripture",
      "description": "Quoted Bible passage: left 4px rule, label + translation tag, body text, optional inset adaptation note. Hover deepens the rule.",
      "html": "<div class=\"ds-scripture\"><div><span class=\"ds-scr-label\">Êxodo 2:24</span><span class=\"ds-scr-type\">NVI</span></div><p class=\"ds-scr-text\">Deus ouviu o gemido deles...</p></div>",
      "css": ".ds-scripture{border-left:4px solid #dfe4ea;padding:.25rem 0 .25rem 1.25rem;margin:1.5rem 0;transition:border-color .2s}.ds-scripture:hover{border-left-color:#9aa7b8}.ds-scr-label{font-weight:800;color:#17181a;font-size:1.05rem}.ds-scr-type{color:#5b7285;font-weight:700;font-size:.95rem;margin-left:.5rem}.ds-scr-text{margin-top:.55rem;font-size:1.05rem;line-height:1.8;color:#24262a}"
    },
    {
      "name": "Color-Coded Callout",
      "kind": "custom",
      "refersTo": "button",
      "description": "The signature pattern: a 3px colored border + tinted fill + white-on-color tag, hover lift. Seven fixed hues reused across all courses.",
      "html": "<div class=\"ds-cx ds-cx-blue\"><span class=\"ds-cx-tag\">Tema</span><h4>...</h4><ul class=\"ds-bullets\"><li>...</li></ul></div>",
      "css": ".ds-cx{border:3px solid #5468d4;background:#e4e8f9;border-radius:12px;padding:1.35rem 1.5rem 1.2rem;margin:1.15rem 0;transition:box-shadow .25s,transform .25s}.ds-cx:hover{box-shadow:0 12px 26px -16px rgba(23,24,26,.45);transform:translateY(-2px)}.ds-cx-tag{display:inline-block;font-size:1rem;font-weight:700;color:#fff;background:#5468d4;padding:1px 13px;border-radius:6px;margin-bottom:.7rem}.ds-cx h4{font-weight:800;font-size:1.06rem;color:#17181a;margin-bottom:.7rem}"
    },
    {
      "name": "Verse Modal",
      "kind": "custom",
      "refersTo": "button",
      "description": "Shared js/verse-modal.js overlay: fixed scrim + white panel, title + scrollable fetched verse text. Opens on .ref/.verse-link click.",
      "html": "<div class=\"ds-modal\"><div class=\"ds-modal-panel\"><h3 class=\"ds-modal-title\">Êxodo 2:24</h3><div class=\"ds-modal-body\">...</div></div></div>",
      "css": ".ds-modal{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.5)}.ds-modal-panel{width:100%;max-width:32rem;border-radius:12px;background:#fff;padding:1.5rem;box-shadow:0 20px 25px -5px rgba(0,0,0,.1)}.ds-modal-title{font-size:1.25rem;font-weight:800;color:#0f172a;margin-bottom:1rem}.ds-modal-body{max-height:60vh;overflow-y:auto;color:#334155;line-height:1.7}"
    },
    {
      "name": "Reading Progress Bar",
      "kind": "custom",
      "refersTo": "button",
      "description": "Fixed 3px top bar tracking scroll progress; scaleX(0->1). Hidden in print and under reduced-motion.",
      "html": "<div class=\"ds-progress\" aria-hidden=\"true\"></div>",
      "css": ".ds-progress{position:fixed;top:0;left:0;height:3px;width:100%;background:#17181a;transform-origin:0 50%;transform:scaleX(0);z-index:60}"
    },
    {
      "name": "Doc Table",
      "kind": "card",
      "refersTo": "button",
      "description": "Rounded data table: 3px border, hidden overflow, tinted header, hover row tint. Used for structured comparison notes.",
      "html": "<table class=\"ds-table\"><thead><tr><th>...</th></tr></thead><tbody><tr><td>...</td></tr></tbody></table>",
      "css": ".ds-table{width:100%;border-collapse:separate;border-spacing:0;border:3px solid #d9dee6;border-radius:14px;overflow:hidden;background:#fff}.ds-table th{background:#e2e6eb;text-align:left;padding:1rem 1.3rem;font-weight:800;font-size:1.02rem;color:#17181a}.ds-table td{padding:1.1rem 1.3rem;border-top:1px solid #e5e7eb;vertical-align:top;line-height:1.78;font-size:.97rem;color:#24262a}.ds-table td+td{border-left:1px solid #e5e7eb}.ds-table tbody tr:hover td{background:#f8fafc}"
    }
  ],
  "narrative": {
    "northStar": "The Annotated Lecture Hall",
    "overview": "A calm, paper-white reading experience for bilingual (PT/EN) Bible-Project class notes. Comprehension-first: long-form reading that stays quiet, Hebrew set correctly right-to-left, and scripture quotations walled off from commentary. Two surfaces share one identity — a Tailwind-based portal grid and Tailwind-v4 session reading pages with a bespoke editorial stylesheet. A single disciplined blue marks every cross-reference; a color-coded callout system turns dense biblical structure into legible diagrams.",
    "keyCharacteristics": [
      "Calm white reading canvas; structure via 3px borders and tints, not heavy shadows.",
      "One blue accent (#0284c7 / #2563eb) for all interactive emphasis, used sparingly.",
      "Signature color-coded callout (cx-*) system assigning each theme a hue + tint.",
      "Bilingual by construction: .lang-pt/.lang-en pairs toggled together via localStorage.",
      "Hebrew in SBL Hebrew, forced RTL; poems/pull-quotes in Newsreader serif."
    ],
    "rules": [
      {
        "name": "The One-Blue Rule",
        "body": "A single blue/sky accent carries all interactive emphasis (links, active language, hover borders). No new interactive hue.",
        "section": "colors"
      },
      {
        "name": "The Tint-Not-Shadow Rule",
        "body": "Depth is conveyed by borders and tonal fills, not resting shadows; shadows appear only on hover/overlay.",
        "section": "elevation"
      },
      {
        "name": "The Serif-Is-Readerly Rule",
        "body": "Newsreader appears only for poems and pull-quotes; never for headings, UI, or body.",
        "section": "typography"
      },
      {
        "name": "The RTL Lock Rule",
        "body": "Hebrew strings use .heb with direction:rtl; never let them inherit LTR flow.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Reading-page surfaces are flat at rest; a shadow appears only on hover/focus/overlay.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Keep Inter for all UI/headings/body; Newsreader for .poem/.quote only.",
      "Set Hebrew in .heb with RTL.",
      "Convey depth with borders and #f6f8fa tints; shadows only on hover/overlay.",
      "Preserve max-w-4xl reading width, PT/EN toggle, and reading-progress bar."
    ],
    "donts": [
      "Introduce a new interactive accent color.",
      "Apply resting drop shadows to reading-page surfaces.",
      "Drop or restyle the bilingual toggle.",
      "Use Newsreader or SBL Hebrew as a display/UI face.",
      "Break @media print rules (hides progress bar/controls, forces .reveal visible)."
    ]
  }
}